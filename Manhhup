local function refreshScale()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local s = math.min(vp.X * 0.92 / 300, vp.Y * 0.8 / 400, 1.1)
	s = math.clamp(s, 0.5, 1.1)
	for _, sc in ipairs(ScaleObjects) do
		if sc.Parent then sc.Scale = s end
	end
end

local function bindViewport()
	local cam = workspace.CurrentCamera
	if cam then
		track(cam:GetPropertyChangedSignal("ViewportSize"):Connect(refreshScale))
	end
	refreshScale()
end
