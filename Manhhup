local HasDrawing = Drawing ~= nil

local function track(conn)
	table.insert(Connections, conn)
	return conn
end

local function getRainbow()
	return Color3.fromHSV((tick() % 4) / 4, 1, 1)
end

local function rainbowBind(obj, prop)
	table.insert(RainbowTargets, {obj, prop})
end

local function addCorner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
	return c
end

local function addStroke(parent, thickness)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness
	s.Parent = parent
	rainbowBind(s, "Color")
	return s
end

local function addScale(parent)
	local sc = Instance.new("UIScale")
	sc.Parent = parent
	table.insert(ScaleObjects, sc)
	return sc
end

local function newLabel(parent, text, size, pos, textSize, font)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = size
	l.Position = pos
	l.Text = text
	l.TextSize = textSize
	l.Font = font
	l.TextColor3 = Color3.new(1, 1, 1)
	l.Parent = parent
	return l
end

local function setProps(obj, props)
	if not obj then return end
	for k, v in pairs(props) do
		obj[k] = v
	end
end

local function makeDraggable(handle, target)
	local status = {Moved = false}
	local dragging, dragStart, startPos = false, nil, nil
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			status.Moved = false
			dragStart = input.Position
			startPos = target.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	track(UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			if delta.Magnitude > 6 then status.Moved = true end
			local sc = target:FindFirstChildOfClass("UIScale")
			local s = sc and sc.Scale or 1
			delta = delta / s
			target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end))
	return status
end

