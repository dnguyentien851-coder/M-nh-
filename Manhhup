local function playIntro()
	local label = newLabel(ScreenGui, "", UDim2.new(0, 600, 0, 80), UDim2.new(0.5, 0, 0.4, 0), 40, Enum.Font.GothamBlack)
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	local textStroke = Instance.new("UIStroke")
	textStroke.Color = Color3.new(0, 0, 0)
	textStroke.Thickness = 3
	textStroke.Parent = label
	addScale(label)
	refreshScale()

	task.spawn(function()
		local text = CONFIG.Title
		for i = 1, #text do
			label.Text = string.sub(text, 1, i)
			task.wait(0.07)
		end
		task.wait(0.8)
		local info = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		local fadeText = TweenService:Create(label, info, {TextTransparency = 1})
		TweenService:Create(textStroke, info, {Transparency = 1}):Play()
		fadeText:Play()
		fadeText.Completed:Wait()
		label:Destroy()
		MainFrame.Visible = true
		ToggleButton.Visible = true
		MenuReady = true
	end)
end

local keyAccepted = false
local function trimKey(s)
	local t = string.gsub(s, "^%s+", "")
	t = string.gsub(t, "%s+$", "")
	return string.upper(t)
end

local function isValidKey(input)
	local clean = trimKey(input)
	for _, k in ipairs(CONFIG.ValidKeys) do
		if clean == string.upper(k) then return true end
	end
	return false
end

SubmitBtn.MouseButton1Click:Connect(function()
	if keyAccepted then return end
	if isValidKey(KeyBox.Text) then
		keyAccepted = true
		StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
		StatusLabel.Text = "Key accepted. Loading..."
		task.wait(0.4)
		KeyFrame:Destroy()
		playIntro()
	else
		StatusLabel.TextColor3 = Color3.fromRGB(255, 70, 70)
		StatusLabel.Text = "Invalid key."
	end
end)

