	valueLbl.TextXAlignment = Enum.TextXAlignment.Right

	local hit = Instance.new("TextButton")
	hit.Size = UDim2.new(1, -24, 0, 24)
	hit.Position = UDim2.new(0, 12, 0, 30)
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.AutoButtonColor = false
	hit.Parent = card

	local trackFrame = Instance.new("Frame")
	trackFrame.Size = UDim2.new(1, 0, 0, 6)
	trackFrame.Position = UDim2.new(0, 0, 0.5, -3)
	trackFrame.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
	trackFrame.BorderSizePixel = 0
	trackFrame.Parent = hit
	addCorner(trackFrame, 3)

	local ratio0 = (default - minV) / (maxV - minV)
	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(ratio0, 0, 1, 0)
	fill.BorderSizePixel = 0
	fill.BackgroundColor3 = getRainbow()
	fill.Parent = trackFrame
	addCorner(fill, 3)
	rainbowBind(fill, "BackgroundColor3")

	local knob = Instance.new("Frame")
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Size = UDim2.new(0, 14, 0, 14)
	knob.Position = UDim2.new(ratio0, 0, 0.5, 0)
	knob.BackgroundColor3 = Color3.new(1, 1, 1)
	knob.BorderSizePixel = 0
	knob.Parent = trackFrame
	addCorner(knob, 7)

	local dragging = false
	local function applyX(x)
		local rel = math.clamp((x - trackFrame.AbsolutePosition.X) / math.max(trackFrame.AbsoluteSize.X, 1), 0, 1)
		local value = math.floor(minV + (maxV - minV) * rel + 0.5)
		fill.Size = UDim2.new(rel, 0, 1, 0)
		knob.Position = UDim2.new(rel, 0, 0.5, 0)
		valueLbl.Text = tostring(value)
		onChange(value)
	end

	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			applyX(input.Position.X)
		end
	end)
	track(UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end))
	track(UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			applyX(input.Position.X)
		end
	end))
	return card
end

