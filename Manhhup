local ESPCache = {}

local BonesR15 = {
	{"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
	{"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
	{"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
	{"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
	{"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
}

local BonesR6 = {
	{"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"},
	{"Torso", "Left Leg"}, {"Torso", "Right Leg"},
}

local function newDrawing(class, props)
	if not HasDrawing then return nil end
	local ok, obj = pcall(Drawing.new, class)
	if not ok or not obj then return nil end
	for k, v in pairs(props) do
		obj[k] = v
	end
	return obj
end

local function getESP(player)
	local cache = ESPCache[player]
	if cache then return cache end
	local black = Color3.new(0, 0, 0)
	cache = {
		Outline = newDrawing("Square", {Thickness = 3, Filled = false, Color = black, Transparency = 1, Visible = false, ZIndex = 1}),
		Box = newDrawing("Square", {Thickness = 1.5, Filled = false, Transparency = 1, Visible = false, ZIndex = 2}),
		Name = newDrawing("Text", {Size = 14, Center = true, Outline = true, OutlineColor = black, Transparency = 1, Visible = false, ZIndex = 3}),
		Distance = newDrawing("Text", {Size = 13, Center = true, Outline = true, OutlineColor = black, Transparency = 1, Visible = false, ZIndex = 3}),
		Tracer = newDrawing("Line", {Thickness = 1.3, Transparency = 1, Visible = false, ZIndex = 2}),
		HpBg = newDrawing("Square", {Filled = true, Color = black, Transparency = 0.5, Visible = false, ZIndex = 1}),
		HpFill = newDrawing("Square", {Filled = true, Transparency = 1, Visible = false, ZIndex = 2}),
		Bones = {},
	}
	for i = 1, CONFIG.BoneCount do
		cache.Bones[i] = newDrawing("Line", {Thickness = CONFIG.BoneThickness, Transparency = 1, Visible = false, ZIndex = 2})
	end
	ESPCache[player] = cache
	return cache
end

local function destroyESP(player)
	local cache = ESPCache[player]
	if not cache then return end
	for key, obj in pairs(cache) do
		if key == "Bones" then
			for _, line in ipairs(obj) do
				pcall(function() line:Remove() end)
			end
		elseif obj then
			pcall(function() obj:Remove() end)
		end
	end
	ESPCache[player] = nil
end

local function hideESP(cache)
	for key, obj in pairs(cache) do
		if key == "Bones" then
			for _, line in ipairs(obj) do
				if line then line.Visible = false end
			end
		elseif obj then
			obj.Visible = false
		end
	end
end

local function updateSkeleton(char, cache, color, cam)
	local list = char:FindFirstChild("UpperTorso") and BonesR15 or BonesR6
	for i = 1, CONFIG.BoneCount do
		local line = cache.Bones[i]
		local pair = list[i]
		local shown = false
		if line and pair then
			local a = char:FindFirstChild(pair[1])
			local b = char:FindFirstChild(pair[2])
			if a and b and a:IsA("BasePart") and b:IsA("BasePart") then
				local pa, va = cam:WorldToViewportPoint(a.Position)
				local pb, vb = cam:WorldToViewportPoint(b.Position)
				if va and vb then
					line.From = Vector2.new(pa.X, pa.Y)
					line.To = Vector2.new(pb.X, pb.Y)
					line.Color = color
					line.Visible = true
					shown = true
				end
			end
		end
		if line and not shown then line.Visible = false end
	end
end

local function isEnemy(player)
	if not State.TeamCheck then return true end
	if LocalPlayer.Team and player.Team == LocalPlayer.Team then return false end
	return true
end

local function isVisible(cam, part)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = {part.Parent}
	if LocalPlayer.Character then
		table.insert(ignore, LocalPlayer.Character)
	end
	params.FilterDescendantsInstances = ignore
	local origin = cam.CFrame.Position
	local hit = workspace:Raycast(origin, part.Position - origin, params)
	return hit == nil
end

local function updateESP(cam, color)
	if not State.ESP then
		for _, cache in pairs(ESPCache) do
			hideESP(cache)
		end
		return
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then continue end
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local valid = char and hum and root and hum.Health > 0 and isEnemy(player)
		local cache = ESPCache[player]

		if not valid then
			if cache then hideESP(cache) end
			continue
		end

		cache = getESP(player)
		local cf, size = char:GetBoundingBox()
		local half = size / 2
		local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
		local inFront = false

		for _, sx in ipairs({-1, 1}) do
			for _, sy in ipairs({-1, 1}) do
				for _, sz in ipairs({-1, 1}) do
					local corner = cf:PointToWorldSpace(Vector3.new(sx * half.X, sy * half.Y, sz * half.Z))
					local p = cam:WorldToViewportPoint(corner)
					if p.Z > 0 then
						inFront = true
						minX = math.min(minX, p.X)
						maxX = math.max(maxX, p.X)
						minY = math.min(minY, p.Y)
						maxY = math.max(maxY, p.Y)
					end
				end
			end
		end

		if not inFront then
			hideESP(cache)
			continue
		end

		local boxW, boxH = maxX - minX, maxY - minY
		local centerX = minX + boxW / 2
		local dist = (root.Position - cam.CFrame.Position).Magnitude
		local frac = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)

		setProps(cache.Outline, {Position = Vector2.new(minX, minY), Size = Vector2.new(boxW, boxH), Visible = true})
		setProps(cache.Box, {Position = Vector2.new(minX, minY), Size = Vector2.new(boxW, boxH), Color = color, Visible = true})
		setProps(cache.Name, {
			Text = string.format("%s [%d HP]", player.Name, math.floor(hum.Health)),
			Position = Vector2.new(centerX, minY - 16),
			Color = color,
			Visible = true,
		})
		setProps(cache.Distance, {
			Text = string.format("%d studs", math.floor(dist)),
			Position = Vector2.new(centerX, maxY + 2),
			Color = Color3.new(1, 1, 1),
			Visible = true,
		})
		setProps(cache.HpBg, {Position = Vector2.new(minX - 6, minY), Size = Vector2.new(3, boxH), Visible = true})
		setProps(cache.HpFill, {
			Position = Vector2.new(minX - 6, minY + boxH * (1 - frac)),
			Size = Vector2.new(3, boxH * frac),
			Color = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), frac),
			Visible = true,
		})
		setProps(cache.Tracer, {
			From = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y),
			To = Vector2.new(centerX, maxY),
			Color = color,
			Visible = true,
		})
		updateSkeleton(char, cache, color, cam)
	end
end

-- =================================================================
-- AIMBOT
-- =================================================================
local function getAimTarget(cam)
	local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
	local best, bestDist = nil, State.Fov
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and isEnemy(player) then
			local char = player.Character
			local head = char and char:FindFirstChild("Head")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if head and hum and hum.Health > 0 then
				local p, onScreen = cam:WorldToViewportPoint(head.Position)
				if onScreen then
					local d = (Vector2.new(p.X, p.Y) - center).Magnitude
					if d <= bestDist and (not State.VisibleCheck or isVisible(cam, head)) then
						best = head
						bestDist = d
					end
				end
			end
		end
	end
	return best
end

local function aimStep()
	if not State.Aimbot then return end
	local cam = workspace.CurrentCamera
	if not cam then return end
	local head = getAimTarget(cam)
	if not head then return end
	local alpha = 1 - (State.Smooth / 100) * 0.95
	local goal = CFrame.lookAt(cam.CFrame.Position, head.Position)
	cam.CFrame = cam.CFrame:Lerp(goal, alpha)
end

RunService:BindToRenderStep("SpiritAim", Enum.RenderPriority.Camera.Value + 1, aimStep)

