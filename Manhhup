-- CHAMS (3 COLOR)
-- =================================================================
local ChamsOriginal = {}
local ChamsTimer = 0
local ChamsActive = false

local function applyChams(char)
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") and not ChamsOriginal[part] then
			ChamsOriginal[part] = {Color = part.Color, Material = part.Material}
			if part.Name == "Head" then
				part.Color = CONFIG.ChamsHead
			elseif string.find(part.Name, "Torso") then
				part.Color = CONFIG.ChamsTorso
			else
				part.Color = CONFIG.ChamsLimb
			end
			part.Material = Enum.Material.Neon
		end
	end
end

local function restoreChams()
	for part, data in pairs(ChamsOriginal) do
		pcall(function()
			part.Color = data.Color
			part.Material = data.Material
		end)
	end
	ChamsOriginal = {}
	ChamsActive = false
end

local function updateChams(now)
	if not State.Chams then
		if ChamsActive then restoreChams() end
		return
	end
	if now - ChamsTimer < CONFIG.ChamsRefresh then return end
	ChamsTimer = now
	ChamsActive = true
	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		if char then applyChams(char) end
	end
	for part in pairs(ChamsOriginal) do
		if not part:IsDescendantOf(workspace) then
			ChamsOriginal[part] = nil
		end
	end
end

